# PQ-VPN .gitignore

# ============================================================================
# BUILD ARTEFACTS
# ============================================================================

bin/
obj/

# ============================================================================
# SECURITY — NEVER COMMIT THESE
# ============================================================================

# Pre-shared key — must be distributed out-of-band, never via git
psk.conf

# Any accidentally generated key or secret files
*.key
*.pem
*.der
*.p12

# ============================================================================
# TEST TEMPORARIES
# ============================================================================

# Temp PSK files written by test_auth.c
/tmp/test_psk*.conf
/tmp/test_generated_psk*.conf
/tmp/test_mac_*.conf

# ============================================================================
# EDITOR AND OS
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# CLion / JetBrains
.idea/
cmake-build-*/

# macOS
.DS_Store

# Linux core dumps
core
core.*
vgcore.*

# ============================================================================
# SANITISER / PROFILING OUTPUT
# ============================================================================

# AddressSanitizer / UBSan logs
*.log
asan.log*

# Valgrind
valgrind-out.txt

# gprof
gmon.out

# ============================================================================
# DISTRIBUTION ARCHIVES
# ============================================================================

*.tar.gz
*.zip

# ============================================================================
# ML-DSA CERTIFICATE FILES — NEVER COMMIT THESE
# ============================================================================

# CA private key — if this leaks anyone can forge certificates
ca_key.priv

# Entity private keys
server_key.priv
client_key.priv
*_key.priv

# Certificates are not secret but keep them out of the repo
# so each deployment generates its own
ca_cert.pub
server_cert.bin
client_cert.bin
*_cert.bin
*_cert.pub
